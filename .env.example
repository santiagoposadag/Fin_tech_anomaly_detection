# ==============================================
# FRAUD DETECTION ENGINE - ENVIRONMENT VARIABLES
# ==============================================
# ⚠️ IMPORTANTE: 
# 1. Copiar este archivo a .env
# 2. Cambiar TODAS las contraseñas
# 3. NUNCA commitear el archivo .env al repositorio
# ==============================================

# MongoDB Configuration
# Cambiar las credenciales en producción
MONGODB_URL=mongodb://admin:CHANGE_THIS_PASSWORD@localhost:27017
MONGODB_DATABASE=fraud_detection

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_TTL=86400

# RabbitMQ Configuration
# Cambiar las credenciales en producción
RABBITMQ_URL=amqp://fraud:CHANGE_THIS_PASSWORD@localhost:5672
RABBITMQ_TRANSACTIONS_QUEUE=transactions
RABBITMQ_MANUAL_REVIEW_QUEUE=manual_review

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Fraud Detection Rules
AMOUNT_THRESHOLD=1500.0
LOCATION_RADIUS_KM=100

# JWT Authentication
# ⚠️ Cambiar por un secreto aleatorio de al menos 256 bits en producción
JWT_SECRET_KEY=change-this-to-a-random-256-bit-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email (SMTP)
# ⚠️ Usar contraseña de aplicación (app-specific password), nunca la contraseña principal
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-specific-password
FROM_EMAIL=your-email@example.com
BASE_URL=http://localhost:3000

# Frontend URLs
ADMIN_DASHBOARD_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
